[Unit]
Description=Fahrzeug-Poller (Traccar -> Supabase)
After=network-online.target traccar.service
Wants=network-online.target

[Service]
Type=oneshot
User=tarik
EnvironmentFile=/etc/fahrzeug-poller.env
WorkingDirectory=/home/tarik/projekte/spargar26/tools/fahrzeug-poller
ExecStart=/usr/bin/node index.mjs
# nicht zu lange hängen bleiben, falls Traccar/Supabase klemmt
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
