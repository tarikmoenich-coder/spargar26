# Kopie nach /etc/fahrzeug-poller.env (chmod 600, root). NICHT ins Repo committen.

# Traccar (lokal auf demselben Server -> localhost reicht)
TRACCAR_URL=http://localhost:8082
# Entweder ein API-Token (Traccar -> Einstellungen -> Benutzer -> Token) ...
TRACCAR_TOKEN=
# ... oder Basic-Auth mit einem (read-only) Traccar-Benutzer:
TRACCAR_USER=
TRACCAR_PASSWORD=

# Supabase - Service-Role-Key (Dashboard -> Project Settings -> API -> service_role)
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Positionen älter als N Tage werden ~1x/Tag gelöscht
RETENTION_DAYS=90

# --- Stufe 2: Alarm außerhalb der Arbeitszeit (optional) ---
# Telegram-Bot bei @BotFather anlegen, in eine Gruppe holen, Chat-ID über
# https://api.telegram.org/bot<TOKEN>/getUpdates ablesen. Fehlen die Werte,
# wird der Alarm nur ins Log geschrieben (kein Push).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Zeitzone für die Arbeitszeit-Prüfung
TIMEZONE=Europe/Berlin
