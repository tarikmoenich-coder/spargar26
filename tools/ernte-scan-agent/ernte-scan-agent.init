#!/bin/sh /etc/rc.common
# procd-Init-Skript fuer RutOS (OpenWrt-Basis) - auf dem TRB246 nach
# /etc/init.d/ernte-scan-agent kopieren, dann:
#   chmod +x /etc/init.d/ernte-scan-agent
#   /etc/init.d/ernte-scan-agent enable
#   /etc/init.d/ernte-scan-agent start
#
# "respawn" startet den Agenten automatisch neu, falls er abstuerzt; "enable"
# sorgt dafuer, dass er nach jedem Neustart des Geraets wieder hochkommt.

START=99
STOP=10
USE_PROCD=1

PROG=/etc/ernte-scan-agent/agent.sh
KONFIG=/etc/ernte-scan-agent/agent.conf

start_service() {
  procd_open_instance
  procd_set_param command /bin/sh "$PROG" "$KONFIG"
  procd_set_param respawn
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
