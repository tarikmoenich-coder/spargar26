# Konfiguration fuer agent.sh - auf dem TRB246 nach /etc/ernte-scan-agent/agent.conf
# kopieren und anpassen. Wird als Shell-Datei eingelesen (einfache KEY=WERT-Zeilen,
# keine Anfuehrungszeichen noetig, aber erlaubt).

# Geraetepfad der RS232-Schnittstelle. Auf dem TRB246 (Hardware-Revision
# 0004, Stand 2026-10-17) ist das IMMER /dev/rs232 - ein fester Symlink, den
# Teltonikas eigenes Boot-Skript (01-serial-symlink.sh) anlegt (siehe
# "dmesg | grep tty": "Creating /dev/ttyUSB0 -> /dev/rs232 symlink"). Die
# externe RS232-Buchse haengt intern an einem USB-Seriell-Chip (ttyUSB0,
# PL2303), NICHT an einer der internen ttyS*-UARTs - ttyS0 ist die
# System-Konsole (nicht anfassen), ttyS1 ist per Symlink /dev/rs485, ttyS2
# vermutlich intern fuers GPS-Modul reserviert. Vorher in Services -> Serial
# Utilities die RS232-Instanz auf "Enable: off" lassen (Console/Over-IP
# wuerden den Port sonst selbst belegen). Bei einer anderen Hardware-Revision
# zur Sicherheit per "ls -la /dev/rs232" gegenpruefen, ob der Symlink noch so
# existiert.
SERIAL_DEV=/dev/rs232

# Baudrate/Format laut Datenblatt des QR-Scan-Moduls (meist 9600 8N1).
SERIAL_BAUD=9600

# Kennung dieser Box im Payload - z.B. die IMEI des Geraets (Status -> Network Info).
BOX_ID=

# Ziel-URL der Supabase Edge Function "ernte-ingest" (siehe
# supabase/functions/ernte-ingest/). Erst eintragen, NACHDEM die Funktion
# deployt wurde (siehe deren README) und die Migration
# migration_2026-10-17_ernte_scan_idempotenz.sql eingespielt ist - bis dahin
# Platzhalter stehen lassen: Scans werden trotzdem gelesen und in
# QUEUE_DATEI gesammelt, nur eben nie verschickt.
INGEST_URL=https://cmlbugppwhytloxjkxmt.supabase.co/functions/v1/ernte-ingest
INGEST_TOKEN=

# Muss auf einem Flash-Pfad liegen, der einen Neustart uebersteht - NICHT
# /tmp (das ist auf RutOS i.d.R. tmpfs/RAM und waere nach Stromverlust leer,
# siehe "Offene Frage Stromausfall" im Plan).
QUEUE_DATEI=/etc/ernte-scan-agent/queue.jsonl

# Wie oft die Warteschlange abgearbeitet wird (Sekunden).
RETRY_INTERVALL_S=30
