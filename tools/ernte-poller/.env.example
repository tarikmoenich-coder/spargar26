# Kopie nach /etc/ernte-poller.env (chmod 600, root). NICHT ins Repo committen.

# Traccar (dieselbe Instanz wie der Fahrzeug-Poller, siehe
# docs/erntewirtschaft-plan.md Teil A - Traccar fuehrt Fahrzeuge UND
# Erntemaschinen zusammen, dieser Poller filtert selbst auf die ihm
# bekannten Maschinen heraus, siehe README)
TRACCAR_URL=http://localhost:8082
# Entweder ein API-Token (Traccar -> Einstellungen -> Benutzer -> Token) ...
TRACCAR_TOKEN=
# ... oder Basic-Auth mit einem (read-only) Traccar-Benutzer:
TRACCAR_USER=
TRACCAR_PASSWORD=

# Supabase - Service-Role-Key (Dashboard -> Project Settings -> API -> service_role)
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Mindestabstand zwischen zwei gespeicherten Positionen je Maschine (Sekunden).
# Traccar selbst bekommt vom TRB246 ca. 1 Punkt/Sekunde - das waere fuer eine
# Saison mit 140 Maschinen zu viel Volumen, siehe erntewirtschaft-plan.md.
POSITION_RATE_S=5

# Positionen aelter als N Tage werden ~1x/Tag geloescht (Default deckt eine
# ganze Saison ab, laenger als beim Fahrzeug-Poller - fuer die
# Laufmeter-/Feldstufen-Auswertung wird die ganze Saison gebraucht)
RETENTION_DAYS=365
