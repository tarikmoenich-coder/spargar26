# Kopie nach .env im selben Ordner (lokal) bzw. /etc/ernte-waage-agent.env
# (Server, chmod 600). NICHT ins Repo committen.

# RHEWA 84vario, Schnittstelle 7 (TCP/IP, Default-Port 8000)
WAAGE_IP=192.168.2.32
WAAGE_PORT=8000
# id aus der Tabelle ernte_waage (die Migration legt beim ersten Lauf
# automatisch "Hofwaage" mit id=1 an)
WAAGE_ID=1

# Scanner-Quelle, solange kein echter 2D-Scanner angeschlossen ist:
#   simuliert = jede ENTER-Taste erzeugt einen Fake-Code (K-TEST-0001, ...)
#               - zum Testen mit echten Gewichten auf der echten Waage
#   stdin     = echte Codes eintippen oder echter USB-HID-Scanner
#   seriell   = RS232-Scanner (noch nicht implementiert)
SCANNER_QUELLE=simuliert

# Nach dem Scan wird per <GN7> gepollt, bis wirklich ein Gewicht auf der
# Waage liegt (der Scanner kann die Kiste schon erkennen, bevor sie
# physisch aufgesetzt ist) - erst dann wird <FP0> fuer den eichfaehigen
# Wert geholt. MINDESTGEWICHT_KG auf die leichteste realistisch befuellte
# Kiste abstimmen (klar ueber dem Leergewicht/Nullpunkt-Rauschen).
MINDESTGEWICHT_KG=2
GEWICHT_POLL_INTERVALL_MS=400
WARTE_AUF_GEWICHT_TIMEOUT_MS=20000

# Supabase - Service-Role-Key (Dashboard -> Project Settings -> API -> service_role)
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Lokale Warteschlangen-Datei (JSON-Zeilen) fuer Supabase-Ausfaelle
QUEUE_DATEI=./ernte-waage-agent-queue.jsonl
RETRY_INTERVALL_MS=30000
