# Kopie nach .env im selben Ordner (lokal) bzw. /etc/ernte-waage-agent.env
# (Server, chmod 600). NICHT ins Repo committen.

# RHEWA 84vario, Schnittstelle 7 (TCP/IP, Default-Port 8000)
WAAGE_IP=192.168.2.32
WAAGE_PORT=8000
# id aus der Tabelle ernte_waage (die Migration legt beim ersten Lauf
# automatisch "Hofwaage" mit id=1 an)
WAAGE_ID=1

# Scanner-Quelle, solange kein echter 2D-Scanner angeschlossen ist:
#   simuliert = jede ENTER-Taste erzeugt einen Fake-Code (K-TEST-0001, ...)
#               - zum Testen mit echten Gewichten auf der echten Waage
#   stdin     = echte Codes eintippen oder USB-HID-Scanner (Tastatur-
#               Emulation) - braucht ein fokussiertes Konsolenfenster,
#               darum NICHT fuer einen unsichtbaren Hintergrunddienst
#               geeignet (siehe "seriell" unten)
#   seriell   = RS232-Scanner ueber COM-Port/USB-Seriell-Adapter - braucht
#               KEINEN Tastaturfokus, darum die richtige Wahl fuer
#               Dauerbetrieb als Hintergrunddienst (z.B. NSSM unter
#               Windows). Siehe SCANNER_SERIELL_* unten.
SCANNER_QUELLE=simuliert

# Nur fuer SCANNER_QUELLE=seriell:
SCANNER_SERIELL_PORT=COM3
SCANNER_SERIELL_BAUDRATE=9600
# Zeilenende, das der Scanner nach jedem Code sendet - viele Geraete im
# RS232-Modus senden nur CR ("\r"), manche CRLF ("\r\n") - im Handbuch des
# jeweiligen Scanner-Modells pruefen.
SCANNER_SERIELL_DELIMITER=\r

# Nach dem Scan wird per <GN7> gepollt, bis sich das Gewicht gegenueber dem
# Stand beim Scan merklich aendert (Kistenwechsel kann ueberlappen - die
# alte Kiste steht beim Scan evtl. noch drauf, darum reicht ein einfacher
# "Gewicht >= X"-Check nicht). Erst danach wird <FP0> fuer den eichfaehigen,
# stabilen Wert geholt.
GEWICHT_AENDERUNG_KG=0.3
GEWICHT_POLL_INTERVALL_MS=400
WARTE_AUF_GEWICHT_TIMEOUT_MS=20000
# Nachtraegliche Plausi-Warnung auf den fertigen Wert (nur Log, die Zeile
# wird trotzdem gespeichert) - auf die leichteste realistisch befuellte
# Kiste abstimmen.
MINDESTGEWICHT_KG=2

# Supabase - Service-Role-Key (Dashboard -> Project Settings -> API -> service_role)
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Lokale Warteschlangen-Datei (JSON-Zeilen) fuer Supabase-Ausfaelle
QUEUE_DATEI=./ernte-waage-agent-queue.jsonl
RETRY_INTERVALL_MS=30000
