NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Firmenhandy-Nummernpool -> Nextcloud-Adressbuch (CardDAV, siehe
# app/api/firmenhandy-sync). Nur serverseitig verwendet, NICHT NEXT_PUBLIC_ -
# darf nie im Browser-Bundle landen.
NEXTCLOUD_CARDDAV_BASE_URL=https://kontakte.spargelhof-moenich.de/remote.php/dav/addressbooks/users/DEIN-NUTZER/firmenhandys/
NEXTCLOUD_CARDDAV_USER=firmenkontakte@spargelhof-moenich.de
NEXTCLOUD_CARDDAV_PASSWORD=dein-app-passwort

# Feld-Import aus Pachtwesen2026 (anderes, eigenständiges Supabase-Projekt,
# siehe app/api/pachtwesen-schlaege). Nur serverseitig verwendet, NICHT
# NEXT_PUBLIC_ - auch wenn es "nur" der Anon-Key des anderen Projekts ist
# (kein echtes Secret), bleibt die URL/der Key serverseitig, damit die
# Browser-Bundles beider Apps sauber getrennt bleiben.
PACHTWESEN_SUPABASE_URL=https://DEIN-PACHTWESEN-PROJEKT.supabase.co
PACHTWESEN_SUPABASE_ANON_KEY=pachtwesen-anon-key
